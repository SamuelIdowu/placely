// prisma/schema.prisma
// Placely — SIWES Placement Marketplace
// Generator: prisma-client (Prisma 7 modern, Rust-free)
// Output: ../src/generated/prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url and directUrl are configured in prisma.config.ts (Prisma 7 requirement)
}

// ──────────────────────────────────────────────
// IDENTITY & AUTH CONTEXT
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  lastName      String?
  passwordHash  String? // credentials auth; null = OAuth only
  role          Role      @default(STUDENT)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       StudentProfile?
  employer      EmployerProfile?
  sentMessages  Message[]
  notifications Notification[]

  @@map("users")
}

enum Role {
  STUDENT
  EMPLOYER
  ADMIN
}

// ──────────────────────────────────────────────
// PROFILE CONTEXT
// ──────────────────────────────────────────────

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  university          String
  discipline          String
  cgpa                Float?
  resumeUrl           String?
  linkedinUrl         String?
  portfolioUrl        String?
  bio                 String?
  profileCompleteness Int     @default(0) // 0–100 computed on save

  verificationStatus  VerificationStatus   @default(PENDING)
  verificationRequest VerificationRequest?

  applications  Application[]
  savedListings SavedListing[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("student_profiles")
}

model EmployerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  cacNumber   String
  description String?
  logoUrl     String?
  websiteUrl  String?

  verificationStatus  VerificationStatus   @default(PENDING)
  verificationRequest VerificationRequest?

  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("employer_profiles")
}

// ──────────────────────────────────────────────
// VERIFICATION CONTEXT
// ──────────────────────────────────────────────

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model VerificationRequest {
  id          String             @id @default(cuid())
  type        VerificationType
  documentUrl String
  status      VerificationStatus @default(PENDING)
  adminNote   String?
  reviewedAt  DateTime?

  studentProfile    StudentProfile?  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  studentProfileId  String?          @unique
  employerProfile   EmployerProfile? @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  employerProfileId String?          @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("verification_requests")
}

enum VerificationType {
  SCHOOL_ID
  CAC_DOCUMENT
}

// ──────────────────────────────────────────────
// PLACEMENT CONTEXT
// ──────────────────────────────────────────────

enum ListingSourceType {
  NATIVE // Posted by registered Placely Employer
  CURATED_EXTERNAL // Ingested from external job portals / social feeds
}

model Listing {
  id                String           @id @default(cuid())
  employerProfile   EmployerProfile? @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  employerProfileId String?

  sourceType      ListingSourceType @default(NATIVE)
  externalUrl     String? // Direct link to external application portal
  contactEmail    String? // HR / Recruiter email for direct SIWES outreach
  externalCompany String? // Company name for curated external listings
  externalLogoUrl String?

  title       String
  description String
  disciplines String[] // e.g. ["Electrical", "Civil", "Computer"]
  location    String
  isRemote    Boolean       @default(false)
  status      ListingStatus @default(OPEN)
  isModerated Boolean       @default(false) // admin flag

  applications Application[]
  savedBy      SavedListing[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("listings")
}

enum ListingStatus {
  OPEN
  CLOSED
}

enum ApplicationType {
  NATIVE
  EXTERNAL_PORTAL
  SIWES_OUTREACH
}

enum OutreachStatus {
  DRAFT
  LETTER_GENERATED
  SENT
  FOLLOWED_UP
  ACCEPTED
  REJECTED
}

model Application {
  id        String            @id @default(cuid())
  listing   Listing           @relation(fields: [listingId], references: [id])
  listingId String
  student   StudentProfile    @relation(fields: [studentId], references: [id])
  studentId String
  status    ApplicationStatus @default(APPLIED)
  note      String? // student's cover note

  applicationType        ApplicationType @default(NATIVE)
  outreachStatus         OutreachStatus?
  outreachLetterUrl      String? // Generated SIWES PDF intro letter URL
  externalCompanyContact String? // Contact email where outreach was directed
  claimToken             String?         @unique // Employer account claim token

  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([listingId, studentId]) // one application per listing per student
  @@map("applications")
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  OFFERED
  ACCEPTED
  DECLINED
}

// ──────────────────────────────────────────────
// COMPANY DIRECTORY CONTEXT (SIWES IT Approved)
// ──────────────────────────────────────────────

model CompanyDirectory {
  id                   String   @id @default(cuid())
  name                 String
  industry             String
  location             String // State / City in Nigeria
  address              String?
  contactEmail         String?
  phone                String?
  websiteUrl           String?
  isUniversityApproved Boolean  @default(false)
  approvedByUniversity String? // e.g. "UNILAG", "FUTA", "UI", "OAU"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("company_directory")
}

// ──────────────────────────────────────────────
// SAVED LISTINGS CONTEXT
// ──────────────────────────────────────────────

model SavedListing {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  listingId        String
  listing          Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([studentProfileId, listingId])
  @@map("saved_listings")
}

// ──────────────────────────────────────────────
// NOTIFICATION CONTEXT
// ──────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  APPLICATION_STATUS
  NEW_MESSAGE
  VERIFICATION_UPDATE
  LISTING_ALERT
}

// ──────────────────────────────────────────────
// MESSAGING (in-placement context)
// ──────────────────────────────────────────────

model Message {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId      String
  body          String
  createdAt     DateTime    @default(now())

  @@map("messages")
}
